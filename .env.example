# ==============================================================================
# EduVerse AI - Root Configuration Template (.env.example)
# Copy to backend/.env and configure your local development values
# ==============================================================================

PROJECT_NAME="EduVerse AI - Intelligent Educational Ecosystem"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL primary, SQLite fallback supported)
DB_ENGINE="postgresql"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="eduverse_db"
# Or explicit async database URL:
# DATABASE_URL="postgresql+asyncpg://postgres:password@127.0.0.1:5432/eduverse_db"
DATABASE_URL="sqlite+aiosqlite:///./eduverse.db"

# JWT Authentication
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-minimum-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase Service (Authentication, Storage, FCM)
FIREBASE_PROJECT_ID="eduverse-ai-dev"
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_STORAGE_BUCKET="eduverse-ai-dev.appspot.com"
FIREBASE_MOCK_MODE=True

# Generative AI & Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8081", "http://127.0.0.1:5173", "http://localhost:8080"]
