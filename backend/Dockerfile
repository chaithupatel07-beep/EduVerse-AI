# EduVerse AI - FastAPI Backend Production Dockerfile (Phase 7)
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for PostgreSQL, build utilities, and OCR support
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application codebase
COPY . .

# Create uploads and vector storage directories
RUN mkdir -p /app/uploads /app/data/vector_store

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
